# Copy this file to .env and add your actual API key
# Any OpenAI-compatible endpoint works. Uncomment ONE provider block below.

# Groq (default)
LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (OpenAI-compatible endpoint; key from https://build.nvidia.com)
# LLM_API_KEY=nvapi-your-nvidia-key-here
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Google Gemini (OpenAI-compatible endpoint)
# LLM_API_KEY=your-gemini-api-key-here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash

# LLM fallback chain (optional). Tries each provider's models in order and skips ones that are
# rate limited or failing (circuit breaker). Replaces the single LLM_* endpoint above when set.
# Providers without a key are skipped. Known: groq (or grok), nvidia, google (free-tier models).
# LLM_PROVIDERS=groq,nvidia,google
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# GOOGLE_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b   # best first; also *_BASE_URL
# GROQ_LLM_MODEL=...           # optional preferred model, tried first (NAME_LLM_API_KEY /
#                             # NAME_LLM_BASE_URL are accepted spellings too)
# GOOGLE_MODEL=gemini-3.5-flash # a preferred model is tried first: pick a FAST one (gemini-3.8-flash
#                             # took 46-95 s per call in testing)
# LLM_BREAKER_FAILURES=3        # failures in a row before an endpoint is skipped
# LLM_BREAKER_COOLDOWN=60       # seconds skipped (a 429 uses its Retry-After, up to the max)
# LLM_BREAKER_MAX_COOLDOWN=900

# Input guard (optional): Span-01 Lite via the OpenRouter Decisions API (alpha). It scores each
# message for harmful/illegal content, jailbreak attempts and out-of-scope topics before the main
# LLM is called; the message is blocked when any score >= GUARD_THRESHOLD. Empty key = disabled.
# GUARD_API_KEY=your-openrouter-api-key-here
# GUARD_URL=https://openrouter.ai/api/alpha/decisions
# GUARD_MODEL=respan/span-01-lite:free
# GUARD_THRESHOLD=0.5

# LangSmith tracing (optional). Off unless LANGSMITH_TRACING=true. Traces include user questions
# and course text; set LANGSMITH_CAPTURE_IO=false to send only timing/structure (no inputs/outputs).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=rag-chatbot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_CAPTURE_IO=true

# Logging (optional). LOG_LEVEL: DEBUG, INFO, WARNING, ERROR. LOG_FILE: also write to a
# rotating log file at this path (relative to backend/ when started via run.sh).
# LOG_LEVEL=INFO
# LOG_FILE=

# Authentication (required). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# JWT_EXPIRE_MINUTES=1440
# USERS_DB_PATH=./users.db

# Network exposure and limits (comma-separated lists; "*" = any)
# ALLOWED_ORIGINS=*
# ALLOWED_HOSTS=*
# MAX_BODY_BYTES=65536
# SESSION_TTL_SECONDS=86400
# MAX_SESSIONS=10000

# Shared state for running more than one process (all optional; empty = single-process defaults)
# DATABASE_URL=postgresql://rag:password@localhost:5432/rag   # else the sqlite file USERS_DB_PATH
# DATABASE_POOL_SIZE=10
# REDIS_URL=redis://localhost:6379/0                          # else in-memory sessions/limits
# INGEST_ON_STARTUP=true        # false when several workers run; use `python ingest.py` instead
# POSTGRES_PASSWORD=            # docker compose only

# Searches the model may run per question (cost guard; it stops earlier when it has enough)
# MAX_TOOL_ROUNDS=3

# Vector store and retrieval (optional)
# VECTOR_BACKEND=chroma         # chroma (embedded, one process) | pgvector (needs DATABASE_URL)
# HYBRID_SEARCH=true            # pgvector only: fuse vector + keyword search (RRF)
# KEYWORD_MAX_DOC_FRACTION=0.05 # keyword side ignores words found in more than this share of chunks
# EMBEDDING_PROVIDER=local      # local (sentence-transformers) | openai (any OpenAI-compatible
#                               # /embeddings endpoint; pgvector only)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_BASE_URL=           # openai provider only
# EMBEDDING_API_KEY=
# EMBEDDING_DIMENSIONS=0        # openai provider: the model's vector size, e.g. 1536
# Changing the embedding model/size needs a rebuild: cd backend && python ingest.py --clear

# Production hardening (all optional)
# ENABLE_API_DOCS=true          # false hides /docs, /redoc and /openapi.json
# ENABLE_HSTS=false             # true only when served over HTTPS
# DAILY_QUERY_QUOTA=500         # questions per user per rolling 24 h; 0 = unlimited
# MAX_HISTORY_CHARS=6000        # history sent to the LLM (~4 chars/token); 0 = unlimited
# MESSAGE_RETENTION_DAYS=0      # delete stored messages older than this at startup; 0 = keep
# CHROMA_PATH=./chroma_db
# DOCS_PATH=../docs
# FRONTEND_PATH=../frontend
# FORWARDED_ALLOW_IPS=127.0.0.1 # proxy addresses whose X-Forwarded-For uvicorn trusts (Docker)

# Operational tunables (all optional; the defaults are what the code used before they moved here)
# JWT_MIN_SECRET_LENGTH=32           MAX_SESSION_ID_LENGTH=128      MAX_MESSAGE_ID_LENGTH=64
# DAILY_QUOTA_RETRY_AFTER=3600       # Retry-After seconds sent when the daily quota is used up
# DB_BUSY_TIMEOUT=10                 # sqlite lock wait (s)
# DATABASE_POOL_MIN=1  DATABASE_POOL_TIMEOUT=10  DATABASE_CONNECT_TIMEOUT=5  DATABASE_STARTUP_WAIT=15
# REDIS_TIMEOUT=2  REDIS_HEALTH_CHECK_INTERVAL=30
# LOG_MAX_BYTES=5242880  LOG_BACKUP_COUNT=3
# GUARD_HISTORY_MESSAGES=4  GUARD_HISTORY_CHARS=300
# HYBRID_RRF_K=60  HYBRID_CANDIDATE_FACTOR=4  HYBRID_MIN_CANDIDATES=20  HYBRID_MAX_KEYWORDS=20
# KEYWORD_STATS_CACHE_SECONDS=300
# EMBEDDING_BATCH_SIZE=64  EMBEDDING_TIMEOUT=30  EMBEDDING_MAX_ATTEMPTS=3
