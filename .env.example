# Copy this file to .env and add your actual API key
# Any OpenAI-compatible endpoint works. Uncomment ONE provider block below.

# Groq (default)
LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Google Gemini (OpenAI-compatible endpoint)
# LLM_API_KEY=your-gemini-api-key-here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# Input guard (optional): Span-01 Lite via the OpenRouter Decisions API (alpha). It scores each
# message for harmful/illegal content, jailbreak attempts and out-of-scope topics before the main
# LLM is called; the message is blocked when any score >= GUARD_THRESHOLD. Empty key = disabled.
# GUARD_API_KEY=your-openrouter-api-key-here
# GUARD_URL=https://openrouter.ai/api/alpha/decisions
# GUARD_MODEL=respan/span-01-lite:free
# GUARD_THRESHOLD=0.5

# Logging (optional). LOG_LEVEL: DEBUG, INFO, WARNING, ERROR. LOG_FILE: also write to a
# rotating log file at this path (relative to backend/ when started via run.sh).
# LOG_LEVEL=INFO
# LOG_FILE=
